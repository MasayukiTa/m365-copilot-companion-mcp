# =============================================================================
# m365-copilot-companion-mcp — environment template
# Copy to .env (DO NOT commit) and replace placeholder values.
# Generate secrets with:
#   python -c "import secrets; print(secrets.token_hex(20))"   # API key
#   python -c "import secrets; print(secrets.token_hex(8))"    # unlock password
# =============================================================================

MCP_API_KEY=replace-with-random-40-hex
MCP_UNLOCK_PASSWORD=replace-with-random-16-hex
MCP_UNLOCK_TTL_DAYS=30

# Filesystem root the agent is allowed to touch. "~" = entire home directory.
# Restrict to a subfolder (e.g. ~/work) for tighter isolation.
MCP_ALLOWED_BASE=~

# ---------- Tool-gateway mode (KEEP THIS ON for Copilot Studio) ----------
# Copilot Studio caps an agent at 70 tools, and every tool's JSON schema costs input
# tokens -- registering all ~138 tools overflows the model's budget on turn 1
# (OpenAIModelTokenLimit) before any work happens. So we register a SMALL high-value
# subset and expose everything else through one `call_tool(name, arguments)` gateway:
#   call_tool(name="")                       -> lists every tool (name + one-line summary)
#   call_tool(name="X")                      -> shows X's signature/usage
#   call_tool(name="X", arguments={...})     -> runs X
# The proven-good config is MCP_TOOL_MAP=1 with MCP_TOOL_MAP_MAX=8. Leaving MCP_TOOL_MAP
# UNSET registers all tools (fine only for full-capability clients like Claude Code, NOT
# Copilot Studio), which is why these ship ACTIVE.
MCP_TOOL_MAP=1
MCP_TOOL_MAP_MAX=8
# Optional: pin a few tools your task needs right after the priority set (comma-separated),
# so they load as first-class tools instead of via the gateway. Everything else is still
# reachable through call_tool. Example:
# MCP_TOOL_MAP_INCLUDE=read_file,write_file,odbc_query,read_excel,ocr_pdf

# ---------- Relay: Researcher / Analyst agents (usually leave UNSET) ----------
# "Researcher" (".dr_work") and "Analyst" (".diceberry") are Microsoft FIRST-PARTY
# M365 Copilot agents -- the SAME agents for every user. The code ships known-good
# DEFAULT URLs for both (see relay/agent_profiles.py), so you normally do NOT set
# these. They are NOT the same URL as each other (different agent => different suffix).
#
# Override ONLY if a default fails to load on your tenant. You don't even have to edit
# by hand: when the relay can't open one of these agents it pops a dialog so you paste
# the right URL (open the agent in M365 Copilot, copy the address-bar URL), and it is
# saved here automatically. So: default in, dialog fallback if it doesn't connect.
# MCP_RESEARCHER_AGENT_URL=https://m365.cloud.microsoft/chat/agent/P_YOUR-GUID.dr_work
# MCP_ANALYST_AGENT_URL=https://m365.cloud.microsoft/chat/agent/P_YOUR-GUID.diceberry

# ---------- Python-only chat bridge (optional) ----------
# bridge/copilot_bridge.py serves a self-contained HTML chat (no Node/npm) and
# streams the agent's answer token-by-token by driving the Copilot web UI over CDP
# -- the "no Premium / no Direct Line" path. Point it at YOUR implementation agent
# (the one with the MCP connector); its URL ends in a tenant GUID, hence .env.
# MCP_IMPL_AGENT_URL=https://m365.cloud.microsoft/chat/agent/T_YOUR-GUID.<id>
# MCP_BRIDGE_PORT=8765
# MCP_CDP_URL=http://localhost:9222
# Recommended: run a DEDICATED, ISOLATED Edge for the companion so it never competes
# for RAM with your personal Edge (many heavy M365 tabs can otherwise crash Edge and
# drop the CDP port). Launch it with:  .\start_companion_edge.ps1   (port below)
# MCP_CDP_PORT=9222

# ---------- Parallel autonomous fleet (optional) ----------
# relay/fleet_runner.py drives several goals at once, each its own Copilot conversation,
# but keeps at most N tabs open (N auto-sized to free RAM) and closes each the instant
# it finishes. The agent the fleet drives (defaults to MCP_IMPL_AGENT_URL):
# MCP_FLEET_AGENT_URL=https://m365.cloud.microsoft/chat/agent/T_YOUR-GUID.<id>

# ---------- Named ODBC connections (optional) ----------
# Each MCP_DB_<NAME>= entry becomes a named connection for odbc_query.
# Authentication uses Windows / Entra ID (Trusted_Connection=Yes or
# Authentication=ActiveDirectoryIntegrated) so no passwords are stored here.
# The agent runs as the logged-in user, so DB access is bounded by that
# user's existing privileges.
#
# Examples (uncomment and adapt to your own servers):
#
# Windows authentication against an on-prem SQL Server:
# MCP_DB_SAMPLE=Driver={ODBC Driver 18 for SQL Server};Server=YOUR-SQL-HOST;Database=YOUR_DB;Trusted_Connection=Yes;TrustServerCertificate=Yes
#
# Entra ID (Azure AD) integrated against Azure SQL:
# MCP_DB_SAMPLE_AZURE=Driver={ODBC Driver 18 for SQL Server};Server=tcp:YOUR-SERVER.database.windows.net,1433;Database=YOUR_DB;Authentication=ActiveDirectoryIntegrated;Encrypt=Yes

# ---------- DB-exploration auto-memory (opt-out; defaults ON) ----------
# After a successful odbc_query / odbc_tables / odbc_columns call, the server
# auto-records what was learned (SQL text, table/column NAMES, and a short
# count summary -- never full result rows) into procedural memory, so a later
# find_db_objects question about the same theme can answer from memory instead
# of re-exploring the DB from scratch. This self-growing DB memory is ON by
# default (including when this var is left unset). Set it to 0 to disable:
# MCP_DATA_MEMORY_AUTO=0
