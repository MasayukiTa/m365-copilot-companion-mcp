!/docs/ADVANCED.md
/docs/validation/
# scratch probes / b64 dumps / one-off data created during eval sessions
/bench/_k*.py
/bench/_pro_*.py
/bench/_cdp_*.py
/bench/_*_b64.txt

# internal bench process docs / work logs: keep in history, exclude going forward
# (architecture/system docs + the README-referenced scorecard stay tracked)
/bench/*.md
!/bench/SCORECARD_swebench_lite300_strong.md

# HumanEval dataset -- not shipped in the repo; fetch it yourself if you want to run that bench
/bench/_data/
bench/gaia/gaia_validation.json
bench/gaia/logs/
bench/gaia/_*.py

# local attic for stray session files (never committed)
_attic/

# ======================================================================
# Purpose-outside path removed from the tree (security review 2026-07-13):
# Minecraft-bot / brain-proxy scripts that turned the corporate Copilot into
# an SSH-tunneled OpenAI-compat backend. Explicit paths (not a broad glob) so
# they cannot be re-added by accident; everything else in scripts/ and
# relay/ stays tracked normally.
# ======================================================================
/scripts/start_brain_tunnel.ps1
/scripts/start_brain_path.ps1
/scripts/brain_lane_scaler.ps1
/relay/brain_proxy.py
/relay/openai_endpoint_server.py
/relay/openai_adapter.py
/relay/test_openai_adapter.py

# ----------------------------------------------------------------------
# Local scratch, dumps, and generated artifacts (never committed).
# ----------------------------------------------------------------------
/_*.txt
/_*.json
/_*.pkl
/_*.b64
/bench/_*.py
/bench/_*.json
/bench/_*.sh
/bench/FINDINGS.json
/relay/CODE_REVIEW_*.md
/HANDOFF.md
/Desktop/
/compact_miasma_vhdx.ps1

# Local security-review output artifacts (run logs / findings dumps)
/security_review/

# External benchmark checkouts / datasets (fetch separately; too large to track)
/bench/ext/

# Local PR investigation scratch (diffs, notes, verification output)
/PR13974_*/

# ----------------------------------------------------------------------
# Ensemble / brain-lane deployment scripts -- same family as the
# brain-proxy scripts removed above (a corporate-Copilot-as-backend path).
# Kept out of the tree for the same reason; do not commit.
# ----------------------------------------------------------------------
/deploy/

# Root-level one-off probes and review dumps.
/_*.py

# Overnight comparison orchestration is a local experiment harness, not product code.
/relay/overnight_task.py

# LOCAL_LOOP SQLite control plane and artifacts are machine-local runtime state.
/.jobs/

# Review run dumps are per-run local evidence, not product code.
/review_artifacts/

# Skills are per-person procedures with site-specific detail (table names, query
# pitfalls, local paths). They are not something everyone should run, and the
# knowledge inside them should not be published. Kept on disk, out of the repo.
skills/
tests/test_copper_scatter_target.py

# Research briefs and planning documents kept beside the code they describe, but not
# published with it: they name internal priorities, effort estimates and unreleased
# research directions. The implementation they produce IS committed -- only the brief
# itself stays local.
docs/research/

# PROBE SCRATCH INSIDE A COMMITTED RESULTS DIRECTORY. A live unlock token reached a public
# repository through `bench/companionbench/results/.agent_token_goal.json`: a probe wrote it
# there because that directory is where results go, and `git add -A` took it. Results are
# committed on purpose, so the directory cannot be ignored wholesale -- dotfiles inside it can,
# and a scratch file has no business being tracked in the first place.
bench/companionbench/results/.*
