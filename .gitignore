# ======================================================================
# Python / venv
# ======================================================================
.venv/
venv/
env/
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.python-version
.ipynb_checkpoints/

# ======================================================================
# MCP server runtime files (secrets / state)
# ======================================================================
.env
.env.*
!.env.example
.unlock_state.json
.todo_state.json
.memory_state.json
.companion_runs/
.companion_gates/

# Resumable bootstrap (setup.bat -> scripts/bootstrap.py)
.setup/
# Generated connector helper embeds the real MCP_API_KEY -> never commit it.
# The redacted template and the README are kept tracked (see ! lines).
generated/*
!generated/README.md
!generated/copilot-connector.template.md

# Demo artifacts that agents may emit into the server CWD via relative paths
copilot_loop_demo/
companion_loop_demo/

# ======================================================================
# Agent Memory (個人情報・社外秘を含むため原則すべて非公開)
# ----------------------------------------------------------------------
# 方針:
#   - メモリの実データ (facts / topics / sessions) はコミットしない
#   - スキーマ説明 (README.md) と空テンプレートのみ追跡する
#   - 新規トピック作成時は templates/ をコピーする運用
# ======================================================================
agent_memory/facts/
agent_memory/topics/
agent_memory/sessions/
agent_memory/index.json

# ただし以下は追跡する (!で除外解除)
!agent_memory/README.md
!agent_memory/templates/
!agent_memory/templates/**

# ======================================================================
# 業務データ (誤コミット防止)
# ======================================================================
*.xlsx
*.xls
*.csv
*.sqlite
*.db
data/
output/
out/
exports/

# ======================================================================
# OS / Editor
# ======================================================================
Thumbs.db
desktop.ini
.DS_Store
*.swp
*.swo
.vscode/
.idea/
*.local.*
*.private.*

# ======================================================================
# Logs / temp / cache
# ======================================================================
*.log
*.tmp
*.bak
~$*
.cache/

ui/*.exe

# parallel fleet live status (runtime)
.fleet/

# vendored VirtualDesktop tool (built from thirdparty/VirtualDesktop11.cs)
thirdparty/*.exe
ui/_buildcheck/

# --- internal working docs / dev artifacts: keep in history, exclude going forward ---
/docs/*.md
!/docs/STARTUP_devtunnel_login.md
!/docs/loop-engineering.md
!/docs/companion_setup.md
# public reference docs linked from the README
!/docs/ARCHITECTURE.md
!/docs/CONFIG.md
!/docs/SECURITY.md
!/docs/TROUBLESHOOTING.md
!/docs/ADVANCED.md
/docs/validation/
# scratch probes / b64 dumps / one-off data created during eval sessions
/bench/_k*.py
/bench/_pro_*.py
/bench/_cdp_*.py
/bench/_*_b64.txt

# internal bench process docs / work logs: keep in history, exclude going forward
# (architecture/system docs + the README-referenced scorecard stay tracked)
/bench/*.md
!/bench/SELF_IMPROVEMENT_CONTROLLER.md
!/bench/SELF_GROWTH_L4_DESIGN.md
!/bench/SYSTEM_MAP.md
!/bench/SCORECARD_swebench_lite300_strong.md

# HumanEval dataset -- not shipped in the repo; fetch it yourself if you want to run that bench
/bench/_data/
bench/gaia/gaia_validation.json
bench/gaia/logs/
bench/gaia/_*.py

# local attic for stray session files (never committed)
_attic/
