<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Target 4.8 so AppContext switch defaults are modern and WPF per-monitor DPI is supported. -->
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/>
  </startup>
  <runtime>
    <!-- Enable WPF Per-Monitor DPI scaling (re-render at each monitor's DPI instead of bitmap-
         stretching the primary-DPI render). Pairs with SetProcessDpiAwarenessContext(PMv2) in
         Main; this side turns on WPF's actual per-monitor relayout. -->
    <AppContextSwitchOverrides value="Switch.System.Windows.DoNotScaleForDpiChanges=false"/>
  </runtime>
</configuration>
